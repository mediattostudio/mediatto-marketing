# Copia estas variables en Vercel → Project → Settings → Environment Variables

# URL pública de tu app (sin diagonal al final)
APP_URL=https://mediatto-marketing.vercel.app

# Acceso a la app
APP_PASSWORD=elige-una-contraseña-larga
SESSION_SECRET=cadena-aleatoria-de-40-caracteres-o-mas

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...

# Meta for Developers → tu app → Configuración → Básica
META_APP_ID=
META_APP_SECRET=

# TikTok for Developers → tu app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Publicar en TikTok (opcional): 1 para activar; POST_MODE=direct para publicar directo en vez de borradores
TIKTOK_PUBLISH=
TIKTOK_POST_MODE=

# Autoriza el cron diario de Vercel y el reloj de publicación de Supabase (cadena aleatoria)
CRON_SECRET=otra-cadena-aleatoria
